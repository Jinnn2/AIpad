      "style": {
        "size": "m",
        "color": "black",
        "opacity": 1.0
      },
      "meta": {
        "author": "human",
        "text": "Evapotranspiration & Vegetation\nRural areas stay cool because of plants. Plants perform Evapotranspiration, a process where they release water vapor into the air, which consumes heat energy and cools the surrounding environment. Urban \"Grey Infrastructure\" lacks this cooling mechanism, leading to higher energy consumption for air conditioning.",
        "summary": "",
        "role": "body",
        "fontFamily": "sans-serif",
        "fontWeight": "400",
        "fontSize": 18,
        "growDir": "right-down",
        "baseWidth": 448,
        "baseHeight": 224,
        "configuredWidth": 448,
        "configuredHeight": 224,
        "lineHeight": 1.4,
        "padding": 0,
        "contentWidth": 410.984375,
        "contentHeight": 201.6,
        "lineCount": 8,
        "renderedText": "Evapotranspiration & Vegetation\nRural areas stay cool because of plants. Plants\nperform Evapotranspiration, a process where\nthey release water vapor into the air, which\nconsumes heat energy and cools the surrounding\nenvironment. Urban \"Grey Infrastructure\" lacks\nthis cooling mechanism, leading to higher energy\nconsumption for air conditioning."
      }
    },
    {
      "id": "text_mmum09z5_ksb1",
      "tool": "text",
      "points": [
        [
          672.0,
          480.0,
          null,
